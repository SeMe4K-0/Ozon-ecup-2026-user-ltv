train.parquet

# Производные артефакты: пересобираются первыми двумя этапами run_pipeline.sh
# примерно за час. 27 ГБ и 5 ГБ соответственно.
artifacts/seq/
artifacts/features/

# Предсказания отдельных сидов: их десятки на модель, а в решении используются
# только усреднённые (final_*.npy без суффикса seed). Пересобираются avg_seeds.py.
artifacts/preds/*_seed*.npy

